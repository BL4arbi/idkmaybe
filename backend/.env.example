PORT=4100

# New database on the existing Postgres server (192.168.0.134). Create it once:
#   CREATE DATABASE tacquet_hub;
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tacquet_hub

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# How long "Se souvenir de moi" keeps someone signed in.
JWT_EXPIRES_IN=30d

# Only accounts with this email domain can be created (leave empty to allow any).
ALLOWED_EMAIL_DOMAIN=

UPLOAD_DIR=./uploads

# Email for ticket notifications only (optional — accounts and passwords never use email).
# Without SMTP_HOST, nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tacquet Hub <no-reply@example.com>"
# Who receives new-ticket emails (comma separated). Defaults to all admins.
ADMIN_NOTIFY_EMAIL=
